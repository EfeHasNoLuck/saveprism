<?xml version="1.0" encoding="utf-8"?>
<!--
  Explorer "Decode with SavePrism" entry for every file, added by the MSI. The MSI installs for
  every user (Program Files), so the entry goes to HKLM. Windows 11 shows the classic verb under
  "Show more options". WiX removes the whole key on uninstall.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="SavePrismDecodeContextMenu" Guid="*" Win64="yes">
        <RegistryKey
          Root="HKLM"
          Key="Software\Classes\*\shell\SavePrism"
          Action="createAndRemoveOnUninstall"
        >
          <RegistryValue Type="string" Value="!(loc.DecodeWithSavePrism)" KeyPath="yes" />
          <RegistryValue Type="string" Name="MUIVerb" Value="!(loc.DecodeWithSavePrism)" />
          <RegistryValue
            Type="string"
            Name="Icon"
            Value="&quot;[INSTALLDIR]saveprism-desktop.exe&quot;,0"
          />
          <RegistryKey Key="command">
            <RegistryValue
              Type="string"
              Value="&quot;[INSTALLDIR]saveprism-desktop.exe&quot; &quot;%1&quot;"
            />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
